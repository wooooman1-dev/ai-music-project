# Server-only secret. Never use a VITE_ prefix for this key.
GEMINI_API_KEY=

# Stable Gemini planning model. Override only after verifying model availability.
GEMINI_MODEL=gemini-3.6-flash

# Local Bright Music ports used by the API server and Vite.
BRIGHT_MUSIC_API_PORT=8788
BRIGHT_MUSIC_WEB_PORT=5190

# Client planning provider. Supported values: gemini, template
VITE_PLANNING_PROVIDER=gemini
